# for i in $(seq 1 10); do /usr/bin/time $shell -i -c exit; done

# functions/timezsh
# Uses hyperfine and forces the interactive block (ZSH_FORCE_INTERACTIVE_RC), which a
# plain `zsh -i -c exit` loop skips when output is not a terminal.
ZSH_FORCE_INTERACTIVE_RC=1 hyperfine --warmup 3 "${1:-$SHELL} -i -c exit"