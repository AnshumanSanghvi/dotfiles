# .functions/fs
# CHANGED: remove the `function fs() { ... }` wrapper and keep only this body. Inside an
# autoloaded file the wrapper makes the first call a no-op. `command du` skips the
# `du -kh` alias; macOS du has no -b, so the original branch always chose -sh anyway.
if [[ -n "$*" ]]; then
  command du -sh -- "$@"
else
  command du -sh .[^.]* ./*
fi